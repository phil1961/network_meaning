# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://network_meaning:CHANGE_ME@localhost:5432/network_meaning
ANTHROPIC_API_KEY=sk-ant-...
# One shared secret for the single-user milestone. Sessions are signed with SESSION_SECRET.
APP_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME_to_a_long_random_string
APP_USER_EMAIL=philipalarson@gmail.com
# HttpPlatformHandler sets PORT from %HTTP_PLATFORM_PORT%. Locally, pick any free port.
PORT=8787
# Optional: model per depth tier
MODEL_QUICK=claude-haiku-4-5
MODEL_DEFAULT=claude-sonnet-5-5
MODEL_COMPLEX=claude-opus-5-5
