{
  "name": "network-meaning",
  "version": "0.9.0",
  "description": "A meaning map of the ideas a person presents: their words kept verbatim, the machine's readings marked, every step in an append-only stream.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "build": "node build.js",
    "check": "node build.js --check",
    "migrate": "node src/server/migrate.js",
    "test": "node --test \"tests/*.test.js\"",
    "gate": "node build.js --check && node --test \"tests/*.test.js\"",
    "smoke": "node tests/smoke.browser.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "pg": "^8.16.0"
  }
}
