<?xml version="1.0" encoding="UTF-8"?>
<!--
  File: web.config
  File Version: 0.2.0

  IIS hosting through HttpPlatformHandler, the same module that runs the
  home finder app's waitress process. IIS starts node.exe with server.js,
  hands it a port in HTTP_PLATFORM_PORT, and proxies requests to it.

  Mounted as the application /network_meaning under the site
  toughguycomputing.net, by bin\setup_network_meaning_v1.0.ps1.

  The paths below are this server's:
    processPath:   node.exe, pinned to the version the app was built on
                   (nvm keeps it at D:\programs\nvm\v24.14.0). Node 22 or
                   later is needed. If nvm removes that version, change it.
    arguments:     full path to this folder's server.js
    stdoutLogFile: where the process log goes (the logs folder, which the
                   app pool can write to)

  server.js reads .env from its own folder, so DATABASE_URL, the API key
  and the owner's password live there, never in this file. A setting given
  here wins over the same setting in .env.

  BASE_PATH is the sub-path the app is mounted under. IIS passes the whole
  address through, and the server takes this prefix off.

  FORCE_HTTPS sends anyone who arrives over plain HTTP to HTTPS, so that a
  password is never sent in the clear. The site has both bindings.

  Saving this file restarts the app's node process, with no need for an
  administrator: IIS notices the change. That is also the way to pick up a
  change to server.js or src (or run binecycle_apppool_v1.0.ps1).

  The two limits are set tight because this site is reachable from the
  internet and sign-up is open: 15 AI calls a day for each person who is
  not an admin, and 60 a day for all of them together. Raise them here, or
  close sign-up with SIGNUP=closed, or ask for an invite code by putting
  SIGNUP_CODE in .env. See README.md, "People, levels and the AI check".
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="NodeHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="D:\programs\nvm\v24.14.0\node.exe"
                  arguments="D:\Projects\network-meaning\server.js"
                  stdoutLogEnabled="true"
                  stdoutLogFile="D:\Projects\network-meaning\logs\iis-stdout.log"
                  startupTimeLimit="60"
                  requestTimeout="00:04:00"
                  processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="BASE_PATH" value="/network_meaning" />
        <environmentVariable name="FORCE_HTTPS" value="true" />
        <environmentVariable name="DAILY_CALL_LIMIT" value="15" />
        <environmentVariable name="DAILY_CALL_CEILING" value="60" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".git" />
          <add segment="node_modules" />
          <add segment="logs" />
          <add segment="src" />
          <add segment="sql" />
          <add segment="tests" />
          <!-- "bin" is already hidden by IIS itself; adding it again is an error. -->
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".js" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
